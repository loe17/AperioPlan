# Diese Datei legt install.sh automatisch an. Manuelle Änderungen danach: docker compose up -d

# Adresse des Servers (für Zertifikat und Freigabelinks)
DOMAIN=localhost
PUBLIC_URL=https://localhost
# veraltet – nur für Installationen vor Version 1.1 mit deploy/Caddyfile.example
TLS_MODE=

# Ports des Servers (nur ändern, wenn 80/443 bereits belegt sind)
HTTP_PORT=80
HTTPS_PORT=443

# Let's Encrypt im lokalen Netz über den DNS-Anbieter (duckdns, cloudflare, hetzner, ionos)
# DNS_PROVIDER=duckdns
# DNS_API_TOKEN=
# COMPOSE_FILE=docker-compose.yml:deploy/compose.dns.yml

# Zufällige Passwörter (install.sh erzeugt diese automatisch)
DB_PASSWORD=bitte-aendern
BACKUP_KEY=

# Programmordner auf dem Server (für die Ein-Klick-Aktualisierung)
APERIO_DIR=/opt/aperioplan

# Speicherorte: lokal oder eingebundenes Netzlaufwerk, z. B. /mnt/nas/projekte
FILES_PATH=./data/files
BACKUP_PATH=./data/backups

TZ=Europe/Berlin

# Optional
# OFFICE_URL=https://plan.firma.de
# TURN_URLS=turn:plan.firma.de:3478
# TURN_PASSWORD=
