<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SolidWorks-Add-in "AperioPlan CAD-Wächter" (.NET Framework 4.8, läuft im SolidWorks-Prozess).
    Bauen unter Windows mit installiertem SolidWorks:  dotnet build -c Release
    Registrieren (als Administrator):                 register.cmd
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AperioPlan.SwAddin</RootNamespace>
    <AssemblyName>AperioPlan.SwAddin</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ComVisible>true</ComVisible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AperioPlan.Core\AperioPlan.Core.csproj" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorksTools">
      <HintPath>$(SolidWorksApiPath)\SolidWorksTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="register.cmd;unregister.cmd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
